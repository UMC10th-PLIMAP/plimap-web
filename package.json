    "lottie-web": "^5.13.0",
    "lucide-react": "^1.23.0",
    "radix-ui": "^1.6.1",
    "react": "latest",
    "react-dom": "latest",
    "react-easy-crop": "^6.2.2",
    "react-router-dom": "latest",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "latest"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
